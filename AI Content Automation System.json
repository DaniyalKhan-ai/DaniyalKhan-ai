        "text": "=Turn the following user content request into an optimized generation prompt.\n\nDescription: {{ $('Webhook').item.json.body.prompt }}\nContent type: {{ $('Webhook').item.json.body.content_type }}\nStyle: {{ $('Webhook').item.json.body.style }}\nAspect ratio: {{ $('Webhook').item.json.body.aspect_ratio }}\nQuality/Duration: {{ $('Webhook').item.json.body.quality }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are an expert AI prompt engineer for image and video generation APIs. Expand the user's request into one clear, vivid, highly detailed generation prompt. DO NOT generate the content yourself. Return ONLY structured JSON matching the required schema: \"prompt\" (the optimized generation prompt string), \"content_type\" (either \"image\" or \"video\", copied from the user request), \"aspect_ratio\" (default \"1:1\" if not provided), \"style\" (empty string if not provided) and \"additional_parameters\" (an object, empty if none)."
        }
