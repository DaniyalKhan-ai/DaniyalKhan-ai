      "parameters": {
        "jsCode": " // Webhook se aane wale data ko capture karna\nconst inputData = $input.first().json.body;\n\n// Clean aur filtered data create karna AI Agent ke liye\nconst filteredData = {\n  // User metadata (Gmail node aur tracking ke liye)\n  user_info: {\n    client_name: inputData.name || \"Valued Client\",\n    client_email: inputData.email || \"\"\n  },\n  \n  // Cleaned Prompt jo AI Agent ko pass hoga\n  ai_payload: {\n    prompt: inputData.prompt,\n    content_type: inputData.content_type,\n    // Style aur Aspect Ratio ko prompt refinement ke liye tailor karna\n    formatted_prompt: `${inputData.prompt}, ${inputData.style ? inputData.style + ' style' : 'photorealistic'}, high resolution, highly detailed`,\n    aspect_ratio: inputData.aspect_ratio || \"16:9\",\n    quality: inputData.quality || \"high\"\n  }\n};\n\n// Return filtered object\nreturn filteredData;"
      },
      "type": "n8n-nodes-base.code",
