        "jsCode": "for (const item of $input.all()) {\n  const randomNum = Math.floor(1000 + Math.random() * 9000);\n  item.json.ticket_id = `TICK-${randomNum}`;\n  item.json.created_at = new Date().toISOString();\n}\nreturn $input.all();"
      },
