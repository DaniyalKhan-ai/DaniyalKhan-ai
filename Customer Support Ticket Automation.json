    {
      "parameters": {
        "jsCode": "const cur = $('Code in JavaScript').first().json;\nconst body = cur.body || {};\nconst email = String(body.email || '').trim().toLowerCase();\nconst subject = String(body.subject || '').trim().toLowerCase();\n// normalize keys (existing sheet may have leading/trailing spaces in headers)\nconst norm = (o) => { const r = {}; for (const k in o) r[String(k).trim()] = o[k]; return r; };\nconst rows = $('Get Existing Tickets').all().map(i => norm(i.json));\nconst isDuplicate = rows.some(r =>\n  String(r.Email || '').trim().toLowerCase() === email &&\n  email !== '' &&\n  String(r.Subject || '').trim().toLowerCase() === subject\n);\nreturn [{ json: { ...cur, is_duplicate: isDuplicate } }];"
      },
      "id": "8433352c-51be-4d7c-8e7f-b23b1a591407",
      "name": "Detect Duplicate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
